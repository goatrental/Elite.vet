<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_shift_type_list" model="ir.ui.view">
        <field name="name">elite.vet.shift.type.list</field>
        <field name="model">elite.vet.shift.type</field>
        <field name="arch" type="xml">
            <list string="Typy směn" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name" string="Název"/>
                <field name="time_from" string="Od" widget="float_time" readonly="is_closed"/>
                <field name="time_to" string="Do" widget="float_time" readonly="is_closed"/>
                <field name="color" string="Barva na webu"/>
                <field name="is_closed" string="Zavřeno"/>
            </list>
        </field>
    </record>

    <record id="action_vet_shift_type" model="ir.actions.act_window">
        <field name="name">Typy směn</field>
        <field name="res_model">elite.vet.shift.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Přidejte typ směny</p>
            <p>Změna času nebo barvy se hned promítne na web — do vysvětlivek
               i do bublin u jmen.</p>
        </field>
    </record>
</odoo>
