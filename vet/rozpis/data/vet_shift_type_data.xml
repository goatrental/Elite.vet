<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Typy smen se zakladaji jen pri instalaci. noupdate="1" znamena, ze
        upgrade modulu uz je neprepise, takze zmena casu nebo barvy udelana
        v Odoo zustane.
    -->
    <data noupdate="1">
        <record id="shift_type_am" model="elite.vet.shift.type">
            <field name="name">Ranní služba</field>
            <field name="sequence">10</field>
            <field name="time_from">8.0</field>
            <field name="time_to">14.0</field>
            <field name="color">green</field>
        </record>
        <record id="shift_type_pm" model="elite.vet.shift.type">
            <field name="name">Odpolední služba</field>
            <field name="sequence">20</field>
            <field name="time_from">14.0</field>
            <field name="time_to">20.0</field>
            <field name="color">orange</field>
        </record>
        <record id="shift_type_night" model="elite.vet.shift.type">
            <field name="name">Noční služba</field>
            <field name="sequence">30</field>
            <field name="time_from">20.0</field>
            <field name="time_to">8.0</field>
            <field name="color">purple</field>
        </record>
        <record id="shift_type_we" model="elite.vet.shift.type">
            <field name="name">Víkendová služba</field>
            <field name="sequence">40</field>
            <field name="time_from">10.0</field>
            <field name="time_to">18.0</field>
            <field name="color">pink</field>
        </record>
        <record id="shift_type_closed" model="elite.vet.shift.type">
            <field name="name">Zavřeno</field>
            <field name="sequence">90</field>
            <field name="color">red</field>
            <field name="is_closed" eval="True"/>
        </record>
    </data>
</odoo>
