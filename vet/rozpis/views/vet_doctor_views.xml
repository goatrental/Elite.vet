<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vet_doctor_list" model="ir.ui.view">
        <field name="name">elite.vet.doctor.list</field>
        <field name="model">elite.vet.doctor</field>
        <field name="arch" type="xml">
            <list string="Lékařky" editable="bottom">
                <field name="name" string="Jméno"/>
            </list>
        </field>
    </record>

    <record id="action_vet_doctor" model="ir.actions.act_window">
        <field name="name">Lékařky</field>
        <field name="res_model">elite.vet.doctor</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Přidejte lékařku</p>
            <p>Jména odsud se nabízejí při zadávání směny.</p>
        </field>
    </record>
</odoo>
